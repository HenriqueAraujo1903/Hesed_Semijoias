# ============================================
# HESED Semijoias - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no repositório!

# ---- Banco de Dados ----
DB_NAME=hesed_db
DB_USERNAME=hesed
DB_PASSWORD=SUA_SENHA_SEGURA_AQUI

# ---- JWT ----
# Gere um segredo com: openssl rand -base64 64
JWT_SECRET=COLE_SEU_SEGREDO_JWT_AQUI
JWT_EXPIRATION_MS=86400000

# ---- CORS ----
# Domínios permitidos (separados por vírgula, sem espaço)
CORS_ALLOWED_ORIGINS=https://seudominio.com.br

# ---- Uploads ----
UPLOAD_BASE_URL=https://seudominio.com.br/uploads

# ---- Domínio (para Nginx/SSL) ----
# DOMAIN=seudominio.com.br
